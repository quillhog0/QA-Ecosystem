#!/usr/bin/env node
const fs = require('fs');
for (let i = 0; i < process.argv.length; i++) {
  const arg = process.argv[i];
  if (arg.startsWith('--outputFile=')) {
    fs.writeFileSync(arg.split('=')[1], `<?xml version="1.0" encoding="UTF-8"?>
<testsuites>
  <testsuite name="vitest" tests="1" failures="0" skipped="0">
    <testcase classname="cached.test.ts" name="test 1"/>
  </testsuite>
</testsuites>
`);
  }
}
console.log('Vitest completed');
process.exit(0);
